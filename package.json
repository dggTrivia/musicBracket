{
  "name": "musicbracket",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 19473 --strictPort",
    "build": "tsc -b && vite build && node scripts/prepare-site.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 19473 --strictPort",
    "test": "tsx --test tests/*.test.ts",
    "catalog:import": "node scripts/catalog-import.mjs",
    "singles:audit": "node scripts/audit-singles.mjs",
    "videos:import": "node scripts/video-import.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "@fontsource/fraunces": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "prettier": "^3.7.0"
  }
}
